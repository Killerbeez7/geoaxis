# Copy to .env.local and fill in.

# Public site URL, e.g. https://geoaxis.bg
PUBLIC_URL=

# Resend API key (re_...)
RESEND_API_KEY=

# Inbox that receives inquiries
CONTACT_EMAIL=

# Sender address on a domain verified in Resend, e.g. "GeoAxis <noreply@geoaxis.bg>".
# Falls back to Resend's test sender when empty.
CONTACT_FROM_EMAIL=
